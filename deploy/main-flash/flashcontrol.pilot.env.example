# Internal HTTP pilot only. Do not use this configuration on an untrusted LAN.
POSTGRES_DB=flashcontrol
POSTGRES_USER=flashcontrol
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

FLASHCONTROL_ENVIRONMENT=development
FLASHCONTROL_MACHINE_AUTH_MODE=token
FLASHCONTROL_DEV_MACHINE_TOKEN=replace-with-a-long-random-machine-token
FLASHCONTROL_TRUSTED_PROXIES=172.30.0.0/24
FLASHCONTROL_LOG_LEVEL=INFO
