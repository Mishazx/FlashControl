# Copy to /opt/flashcontrol/shared/flashcontrol.env and chmod 600.
# Values are passed directly to Docker; do not add shell quotes.
POSTGRES_DB=flashcontrol
POSTGRES_USER=flashcontrol
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

FLASHCONTROL_ENVIRONMENT=production
FLASHCONTROL_MACHINE_AUTH_MODE=mtls
FLASHCONTROL_TRUSTED_PROXIES=172.30.0.0/24
FLASHCONTROL_TRUSTED_MTLS_PROXIES=172.30.0.0/24
FLASHCONTROL_MTLS_IDENTITIES={"replace-with-sha256-fingerprint":{"kind":"agent","id":"replace-with-agent-uuid"}}
FLASHCONTROL_LDAP_SERVER_URI=ldap://dc.example.local
FLASHCONTROL_LDAP_BASE_DN=DC=example,DC=local
FLASHCONTROL_LDAP_DOMAIN_NAME=EXAMPLE
FLASHCONTROL_LDAP_GROUP_PARENT_DN=OU=Groups,DC=example,DC=local
FLASHCONTROL_LDAP_ACCESS_GROUP=FlashControl
FLASHCONTROL_LDAP_ADMIN_GROUPS=FlashControl-Admins
FLASHCONTROL_LDAP_SECURITY_GROUPS=FlashControl-Security
FLASHCONTROL_LDAP_AUDITOR_GROUPS=FlashControl-Auditors
FLASHCONTROL_LOG_LEVEL=INFO
