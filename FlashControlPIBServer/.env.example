# Copy to .env, set file permissions to owner-read/write only, and never commit it.
# Generate FLASHCONTROL_POSTGRES_PASSWORD with a password manager. Percent-encode
# reserved URL characters when placing the same password in DATABASE_URL.
FLASHCONTROL_POSTGRES_DB=flashcontrol
FLASHCONTROL_POSTGRES_USER=flashcontrol
FLASHCONTROL_POSTGRES_PASSWORD=replace-with-a-unique-long-random-password
FLASHCONTROL_DATABASE_URL=postgresql+psycopg://flashcontrol:replace-with-url-encoded-password@postgres:5432/flashcontrol

# PEM files mounted into the Nginx container for HTTPS.
FLASHCONTROL_TLS_CERT_PATH=/absolute/path/to/tls.crt
FLASHCONTROL_TLS_KEY_PATH=/absolute/path/to/tls.key
