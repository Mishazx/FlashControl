FLASHCONTROL_ENVIRONMENT=development
FLASHCONTROL_DATABASE_URL=sqlite:///./flashcontrol-dev.db
# PostgreSQL: postgresql+psycopg://flashcontrol:flashcontrol@localhost:5432/flashcontrol
FLASHCONTROL_LOG_LEVEL=INFO
FLASHCONTROL_SESSION_HOURS=8
FLASHCONTROL_MACHINE_AUTH_MODE=token
FLASHCONTROL_DEV_MACHINE_TOKEN=replace-with-a-long-random-development-secret
# Active Directory login (same bind flow as PIB Portal):
# FLASHCONTROL_LDAP_SERVER_URI=ldap://dc.example.local
# FLASHCONTROL_LDAP_START_TLS=false
# FLASHCONTROL_LDAP_TLS_CERT_POLICY=demand
# FLASHCONTROL_LDAP_BASE_DN=DC=example,DC=local
# FLASHCONTROL_LDAP_DOMAIN_NAME=EXAMPLE
# FLASHCONTROL_LDAP_GROUP_PARENT_DN=OU=Groups,DC=example,DC=local
# FLASHCONTROL_LDAP_ACCESS_GROUP=FlashControl
# FLASHCONTROL_LDAP_ADMIN_GROUPS=FlashControl-Admins
# FLASHCONTROL_LDAP_SECURITY_GROUPS=FlashControl-Security
# FLASHCONTROL_LDAP_AUDITOR_GROUPS=FlashControl-Auditors
# Honor X-Real-IP / X-Forwarded-For only from these HTTP reverse proxies:
# FLASHCONTROL_TRUSTED_PROXIES=172.30.0.0/24
# Production machine authentication (TLS terminator must overwrite these headers):
# FLASHCONTROL_MACHINE_AUTH_MODE=mtls
# FLASHCONTROL_TRUSTED_MTLS_PROXIES=127.0.0.1/32,10.0.0.10/32
# FLASHCONTROL_MTLS_IDENTITIES={"aabbcc...":"agent:AGENT-UUID","ddeeff...":"proxy:PROXY-UUID"}
