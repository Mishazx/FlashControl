FLASHCONTROL_ENVIRONMENT=development
FLASHCONTROL_DATABASE_URL=sqlite:///./flashcontrol-dev.db
# PostgreSQL: postgresql+psycopg://flashcontrol:flashcontrol@localhost:5432/flashcontrol
FLASHCONTROL_LOG_LEVEL=INFO
FLASHCONTROL_AUTH_PROVIDER=local
FLASHCONTROL_SESSION_HOURS=8
FLASHCONTROL_MACHINE_AUTH_MODE=token
FLASHCONTROL_DEV_MACHINE_TOKEN=replace-with-a-long-random-development-secret
# Production only:
# FLASHCONTROL_AUTH_PROVIDER=oidc
# FLASHCONTROL_OIDC_ISSUER=https://idp.example/tenant
# FLASHCONTROL_OIDC_CLIENT_ID=flashcontrol
# FLASHCONTROL_OIDC_CLIENT_SECRET=use-a-secret-store-for-confidential-clients
# FLASHCONTROL_OIDC_REDIRECT_URI=https://flashcontrol.example/api/v1/auth/oidc/callback
# FLASHCONTROL_OIDC_GROUP_CLAIM=groups
# Group names or immutable object IDs, comma-separated:
# FLASHCONTROL_OIDC_ADMIN_GROUPS=flashcontrol-admins
# FLASHCONTROL_OIDC_SECURITY_GROUPS=flashcontrol-security
# FLASHCONTROL_OIDC_AUDITOR_GROUPS=flashcontrol-auditors
# Production machine authentication (TLS terminator must overwrite these headers):
# FLASHCONTROL_MACHINE_AUTH_MODE=mtls
# FLASHCONTROL_TRUSTED_MTLS_PROXIES=127.0.0.1/32,10.0.0.10/32
# FLASHCONTROL_MTLS_IDENTITIES={"aabbcc...":"agent:AGENT-UUID","ddeeff...":"proxy:PROXY-UUID"}
