FROM node:22-alpine AS build

WORKDIR /app
COPY web-react/package.json web-react/package-lock.json* ./
# package-lock.json is optional in this repository, so use install rather than
# npm ci; this also keeps the production push deployable until a lockfile is
# committed.
RUN npm install
COPY web-react/ ./
RUN npm run build

FROM nginx:alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
